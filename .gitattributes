# Normaliza finales de línea
* text=auto eol=lf

# PHP
*.php text eol=lf

# JS / Front
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.json text eol=lf

# Config / Docs
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# Scripts (si usas bash)
*.sh text eol=lf

# Windows scripts
*.bat text eol=crlf

# Binarios (no tocar)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary

# Evita problemas con vendor
/vendor/** -text
