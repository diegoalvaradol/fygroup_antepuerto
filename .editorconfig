root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

indent_style = space
indent_size = 4

# PHP (backend)
[*.php]
indent_size = 4

# Frontend
[*.{js,jsx,ts,tsx,css,scss,html,json}]
indent_size = 2

# YAML
[*.{yml,yaml}]
indent_size = 2

# Markdown (no romper espacios)
[*.md]
trim_trailing_whitespace = false

# Scripts
[*.sh]
indent_size = 2
end_of_line = lf

# Windows
[*.bat]
end_of_line = crlf
